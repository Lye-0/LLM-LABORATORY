---
import LegacyMap from '../../../components/atlas/LegacyMap.astro';
import { legacyNodes } from '../../../data/atlas/legacy';
export function getStaticPaths() {
  return Object.keys(legacyNodes).map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
---

<LegacyMap slug={slug} />
