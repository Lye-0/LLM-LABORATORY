---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import WorldMap from '../../../components/maps/WorldMap.astro';
import { learningMaps } from '../../../data/maps';
import { withBase } from '../../../lib/paths';
import '../../../styles/maps.css';
---

<SiteLayout
  title="図でつなぐ — LLMの全体地図"
  description="入力・処理・出力、学習と改造の関係を一枚の地図で見渡す。"
  wide
>
  <nav class="map-breadcrumb" aria-label="パンくず">
    <a href={withBase('/learn/')}>学ぶ</a>
    <span>/ 図でつなぐ</span>
  </nav>
  <header class="page-header map-intro">
    <div class="eyebrow">LLM AT A GLANCE</div>
    <h1>LLMの全体地図</h1>
    <p>文章はどこを通り、データはどう変わる？ 推論・学習・改造を、ひとつの地図で見渡します。</p>
  </header>
  <WorldMap />
  <p class="map-legend">
    B：入力件数 ／ T：トークン数 ／ D：ベクトルの幅 ／ V：候補数。図は基本形を整理した模式表示です。
  </p>
  <nav class="map-directory" aria-label="詳しく見る地図">
    {learningMaps.map((map, i) => (
      <a href={withBase(`/learn/maps/${map.slug}/`)}>
        <span class="mono">0{i + 1}</span>
        <strong>{map.title}</strong>
        <span aria-hidden="true">↗</span>
      </a>
    ))}
  </nav>
  <div class="map-footer-links">
    <a href={withBase('/learn/maps/inference/?inference=embedding')}>
      QwenのEmbeddingをこの流れで見る →
    </a>
    <a href={withBase('/learn/maps/training/small-model/')}>小さなモデルを作る実行教材 →</a>
  </div>
</SiteLayout>
