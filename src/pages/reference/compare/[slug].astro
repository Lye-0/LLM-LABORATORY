---
import { withBase } from '../../../lib/paths';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import { comparisons } from '../../../data/glossary';
import { Code } from 'astro:components';
export function getStaticPaths() {
  return comparisons.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
const { item } = Astro.props;
---

<SiteLayout title={item.title}>
  <nav class="breadcrumb">
    <a href={withBase('/reference/compare/')}>似た機能の違い</a>
    <span>/</span>
    <span>{item.title}</span>
  </nav>
  <header class="page-header">
    <div class="eyebrow">COMPARISON</div>
    <h1>{item.title}</h1>
    <p>{item.rule}</p>
  </header>
  <div class="info-grid">
    <div class="info-card">
      <h2>
        <code>{item.left}</code>
      </h2>
      <p>{item.a}</p>
    </div>
    <div class="info-card">
      <h2>
        <code>{item.right}</code>
      </h2>
      <p>{item.b}</p>
    </div>
  </div>
  <div class="section-title">
    <h2>書き方を比べる</h2>
  </div>
  <p class="intro-note">
    前提の変数・オブジェクトは対応する教材で準備します。ここでは、違いが現れる呼び出しを抜粋しています。
  </p>
  <Code code={item.example} lang="python" />
  <a href={withBase(`/learn/${item.lesson}/`)} class="button">
    コードと結果を教材で確認する
  </a>
</SiteLayout>
