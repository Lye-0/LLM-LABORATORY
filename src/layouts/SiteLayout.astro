---
import { withBase, withoutBase } from '../lib/paths';
import { getCollection } from 'astro:content';
import { stages, labs } from '../data/catalog';
import { projects } from '../data/projects';
import { topics } from '../data/topics';
import { maps, mapUrl } from '../data/atlas';
import { apiLibraries, apiClasses, getApiClass } from '../data/api-groups';
import { apiEntries } from '../data/api';
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
  canonical?: string;
  noindex?: boolean;
}
const {
  title,
  description = 'LLMの仕組みを、読む・動かす・調べる。基礎からモデル改造へつなぐ学習サイト。',
  wide = false,
  canonical,
  noindex = false,
} = Astro.props;
const lessons = (await getCollection('lessons')).sort((a, b) => a.data.order - b.data.order);
const path = withoutBase(Astro.url.pathname);
const nav = [
  { href: '/maps/', label: '地図', no: '01' },
  { href: '/learn/', label: '学ぶ', no: '02' },
  { href: '/labs/', label: '実験する', no: '03' },
  { href: '/reference/', label: '調べる', no: '04' },
  { href: '/projects/', label: '改造する', no: '05' },
];
const activeSection = path.startsWith('/maps/')
  ? '/maps/'
  : path.startsWith('/labs/')
    ? '/labs/'
    : path.startsWith('/projects/')
      ? '/projects/'
      : path.startsWith('/reference/') || path.startsWith('/topics/')
        ? '/reference/'
        : path.startsWith('/learn/') || path.startsWith('/environment/')
          ? '/learn/'
          : '';
const apiDetail = apiEntries.find((e) => path === `/reference/api/${e.slug}/`);
const detailClass = apiDetail ? getApiClass(apiDetail.owner) : undefined;
interface SideGroup {
  title: string;
  number?: string;
  links: { href: string; label: string }[];
}
let sidebarHome = { href: '/', label: 'サイトの案内' };
let sidebarGroups: SideGroup[] = [];
if (activeSection === '/maps/') {
  sidebarHome = { href: '/maps/', label: '全体地図' };
  sidebarGroups = [
    {
      title: '流れを追う',
      links: maps.slice(1, 4).map((m) => ({ href: mapUrl(m.slug), label: m.title })),
    },
    {
      title: '構成を知る',
      links: maps.slice(4, 7).map((m) => ({ href: mapUrl(m.slug), label: m.title })),
    },
    {
      title: '応用へつなぐ',
      links: maps.slice(7).map((m) => ({ href: mapUrl(m.slug), label: m.title })),
    },
  ];
} else if (activeSection === '/learn/') {
  sidebarHome = { href: '/learn/', label: '学ぶ：全体と教材一覧' };
  sidebarGroups = [
    {
      title: '地図で見る',
      links: [{ href: '/maps/', label: '全体地図へ ↗' }],
    },
    ...stages.map((stage) => ({
      title: stage.title,
      number: stage.number,
      links: [
        ...lessons
          .filter((l) => l.data.stage === stage.id)
          .map((l) => ({ href: `/learn/${l.id}/`, label: l.data.title })),
        ...(stage.id === 'training'
          ? [{ href: '/learn/maps/training/small-model/', label: '小さなモデルを作る（実行例）' }]
          : []),
      ],
    })),
  ];
} else if (activeSection === '/labs/') {
  sidebarHome = { href: '/labs/', label: '実験一覧' };
  sidebarGroups = stages
    .filter((stage) => labs.some((l) => l.category === stage.id))
    .map((stage) => ({
      title: stage.title,
      links: labs
        .filter((l) => l.category === stage.id)
        .map((l) => ({ href: `/labs/${l.slug}/`, label: l.ja })),
    }));
} else if (activeSection === '/reference/') {
  sidebarHome = { href: '/reference/', label: 'リファレンス' };
  sidebarGroups = [
    {
      title: '調べ方を選ぶ',
      links: [
        { href: '/reference/api/', label: 'ライブラリ・クラス' },
        { href: '/reference/tokens/', label: '特殊・追加トークン' },
        { href: '/reference/glossary/', label: '用語集' },
        { href: '/reference/compare/', label: '似た機能の違い' },
      ],
    },
    ...apiLibraries.map((library) => ({
      title: library.title,
      links: [
        { href: `/reference/libraries/${library.slug}/`, label: `${library.title}の一覧` },
        ...apiClasses
          .filter((c) => c.library === library.slug)
          .map((c) => ({ href: `/reference/classes/${c.slug}/`, label: c.title })),
      ],
    })),
    {
      title: '周辺技術',
      links: topics.map((t) => ({ href: `/topics/${t.slug}/`, label: t.title })),
    },
  ];
} else if (activeSection === '/projects/') {
  sidebarHome = { href: '/projects/', label: '改造課題の一覧' };
  sidebarGroups = [
    {
      title: '課題から選ぶ',
      links: projects.map((p) => ({ href: `/projects/${p.slug}/`, label: p.title })),
    },
  ];
} else {
  sidebarGroups = [
    { title: '目的から選ぶ', links: nav.map((item) => ({ href: item.href, label: item.label })) },
    {
      title: 'すぐに調べる',
      links: [
        { href: '/search/', label: 'サイト内検索' },
        { href: '/reference/api/', label: 'ライブラリ・クラス' },
        { href: '/reference/tokens/', label: '特殊・追加トークン' },
      ],
    },
  ];
}
function isCurrentLink(href: string) {
  return path === href || (detailClass && href === `/reference/classes/${detailClass.slug}/`);
}
---

<!doctype html>
<html lang="ja" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {canonical && (
      <link
        rel="canonical"
        href={new URL(withBase(canonical), Astro.site || 'https://lye-0.github.io/')}
      />
    )}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#11171d" />
    <title>{title === 'Home' ? 'LLM LABORATORY — モデルを、内側から理解する。' : `${title} · LLM LABORATORY`}</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <script is:inline>
      try {
        const t = localStorage.getItem('llmlab-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      本文へ移動
    </a>
    <header class="site-header">
      <a href={withBase('/')} class="brand" aria-label="LLM LABORATORY ホーム">
        <span class="brand-mark" aria-hidden="true">
          L<span>·</span>
        </span>
        <span>
          LLM<span class="brand-sub">LABORATORY</span>
        </span>
      </a>
      <nav class="top-nav" aria-label="メインナビゲーション">
        {nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={{ active: activeSection === item.href }}
            aria-current={activeSection === item.href ? 'page' : undefined}
          >
            <span>{item.no}</span>
            {item.label}
          </a>
        ))}
      </nav>
      <div class="header-actions">
        <a class="search-trigger" href={withBase('/search/')} aria-label="サイト内を検索">
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            aria-hidden="true"
          >
            <circle cx="10.5" cy="10.5" r="6.5" />
            <path d="m16 16 5 5" />
          </svg>
          <span>検索</span>
          <kbd>/</kbd>
        </a>
        <button
          class="icon-button"
          id="theme-toggle"
          aria-label="明暗テーマを切り替える"
          title="明暗テーマ"
        >
          <svg
            viewBox="0 0 24 24"
            width="19"
            height="19"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4v16" />
          </svg>
        </button>
        <button
          class="icon-button mobile-menu"
          id="menu-toggle"
          aria-label="ナビゲーションを開く"
          aria-expanded="false"
          aria-controls="sidebar"
        >
          ☰
        </button>
      </div>
    </header>
    <div class="nav-scrim" id="nav-scrim" hidden></div>
    <aside class="sidebar" id="sidebar" aria-label="セクションナビゲーション">
      <nav class="sidebar-sections" aria-label="モバイルのメインナビゲーション">
        {nav.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={activeSection === item.href ? 'page' : undefined}
          >
            {item.no} {item.label}
          </a>
        ))}
      </nav>
      <a
        href={withBase(sidebarHome.href)}
        class="sidebar-home"
        aria-current={path === sidebarHome.href ? 'page' : undefined}
      >
        <span class="tiny-square"></span>
        {sidebarHome.label}
        <span class="mono">INDEX</span>
      </a>
      {sidebarGroups.map((group) => (
        <section class="nav-group">
          <h2>
            {group.number && <span>{group.number}</span>}
            {group.title}
          </h2>
          <ul>
            {group.links.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  aria-current={isCurrentLink(item.href) ? 'page' : undefined}
                >
                  <span class="nav-dot"></span>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
      <div class="sidebar-bottom">
        <p>共通ガイド</p>
        <a
          href={withBase('/environment/')}
          aria-current={path === '/environment/' ? 'page' : undefined}
        >
          実行環境と使い方
        </a>
        <a
          href={withBase('/reference/sources/')}
          aria-current={path === '/reference/sources/' ? 'page' : undefined}
        >
          参考資料・モデル条件
        </a>
        <p>READ. OBSERVE. UNDERSTAND.</p>
      </div>
    </aside>
    <div class:list={['site-body', { 'is-wide': wide }]}>
      <main id="main" data-pagefind-body>
        <slot />
      </main>
      <footer class="site-footer" data-pagefind-ignore>
        <span>LLM LABORATORY</span>
        <p>仕組みを理解し、確かめながら、その先へ。</p>
        <a href={withBase('/reference/sources/')}>出典とデータについて</a>
      </footer>
    </div>
    <div id="global-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import { withBase } from '../lib/paths';
      const menu = document.querySelector<HTMLButtonElement>('#menu-toggle');
      const scrim = document.querySelector<HTMLElement>('#nav-scrim');
      const siteBody = document.querySelector<HTMLElement>('.site-body');
      function closeMenu() {
        document.body.classList.remove('nav-open');
        menu?.setAttribute('aria-expanded', 'false');
        if (scrim) scrim.hidden = true;
        if (siteBody) siteBody.inert = false;
      }
      menu?.addEventListener('click', () => {
        const open = !document.body.classList.contains('nav-open');
        document.body.classList.toggle('nav-open', open);
        menu.setAttribute('aria-expanded', String(open));
        if (scrim) scrim.hidden = !open;
        if (siteBody) siteBody.inert = open;
      });
      scrim?.addEventListener('click', closeMenu);
      window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
        if (event.matches) closeMenu();
      });
      document.querySelector('#theme-toggle')?.addEventListener('click', () => {
        const theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem('llmlab-theme', theme);
        } catch {}
        const status = document.querySelector('#global-status');
        if (status)
          status.textContent =
            theme === 'dark' ? '暗色テーマに変更しました' : '明色テーマに変更しました';
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Tab' && document.body.classList.contains('nav-open') && menu) {
          const items = [menu, ...document.querySelectorAll<HTMLAnchorElement>('#sidebar a')];
          const last = items.at(-1);
          if (e.shiftKey && document.activeElement === menu) {
            e.preventDefault();
            last?.focus();
          }
          if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            menu.focus();
          }
        }
        if (e.key === 'Escape' && document.body.classList.contains('nav-open')) {
          closeMenu();
          menu?.focus();
        }
        if (
          e.key === '/' &&
          !(e.target instanceof HTMLInputElement) &&
          !(e.target instanceof HTMLTextAreaElement) &&
          !document.querySelector('[role="listbox"]') &&
          !(e.target instanceof HTMLElement && e.target.closest('[role="combobox"]')) &&
          !(e.target instanceof HTMLElement && e.target.isContentEditable)
        ) {
          e.preventDefault();
          window.location.href = withBase('/search/');
        }
      });
      // Wide lesson tables need a keyboard scroll target at narrow widths.
      const scrollTables = document.querySelectorAll<HTMLElement>('.prose table:not([tabindex])');
      const updateTableFocus = (table: HTMLElement) => {
        if (table.scrollWidth > table.clientWidth) table.tabIndex = 0;
        else table.removeAttribute('tabindex');
      };
      const tableResize = new ResizeObserver((entries) => {
        entries.forEach(({ target }) => updateTableFocus(target as HTMLElement));
      });
      scrollTables.forEach((table) => {
        updateTableFocus(table);
        tableResize.observe(table);
      });
      document.querySelectorAll('pre').forEach((pre) => {
        if (pre.closest('[data-no-copy], astro-island')) return;
        const button = document.createElement('button');
        button.className = 'copy-code';
        button.type = 'button';
        button.textContent = 'コピー';
        button.setAttribute('aria-label', 'このコードをコピー');
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
            button.textContent = 'コピーしました';
            setTimeout(() => (button.textContent = 'コピー'), 1800);
          } catch {
            button.textContent = '選択してコピー';
          }
        });
        pre.append(button);
      });
    </script>
  </body>
</html>
