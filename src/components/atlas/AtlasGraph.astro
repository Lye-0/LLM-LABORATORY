---
import { nodeById, nodeUrl, sectionById, type AtlasMap, type AtlasSection } from '../../data/atlas';
import { withBase } from '../../lib/paths';
import { crossConnections } from '../../data/atlas/connections';
import { supplements } from '../../data/atlas/supplements';
interface Props {
  section: AtlasSection;
  map: AtlasMap;
  number: number;
  continuation?: { data: string; links: NonNullable<AtlasSection['links']> };
  continues?: boolean;
}
const { section, map, number, continuation, continues = false } = Astro.props;
const visible = new Set(
  map.sections.flatMap((id) => sectionById[id].blocks.flatMap((b) => b.lanes.flat())),
);
const relations = [
  ...section.edges,
  ...crossConnections
    .filter(([from, to]) => visible.has(from) && visible.has(to))
    .map(([from, to]) => ({ from, to, label: undefined })),
];
const presentNode = (id: string) =>
  id === 'prefill' && map.slug === 'training'
    ? {
        ...nodeById[id],
        title: '学習用batchの計算を開始',
        code: 'forward（学習）',
        meaning:
          '学習用の入力列を、この先のEmbedding〜LM headで計算する。生成時の初回計算はprefillと呼ぶ。',
      }
    : nodeById[id];
---

<section
  class:list={[
    'atlas-section',
    { 'atlas-section--continuation': continuation, 'atlas-section--continues': continues },
  ]}
  id={`s-${section.id}`}
  aria-labelledby={`heading-${section.id}`}
>
  <div class:list={{ 'atlas-boundary': continuation }}>
    <header class="atlas-section-heading">
      <span class="atlas-number">{String(number).padStart(2, '0')}</span>
      <div>
        <h2 id={`heading-${section.id}`}>{section.title}</h2>
        <p>{section.note}</p>
      </div>
    </header>
    {continuation && (
      <div class="atlas-boundary-notes">
        <p class="atlas-transfer">{continuation.data}</p>
        <nav aria-label={`${section.title}の関連する接続`}>
          {continuation.links.map((link) => (
            <a href={withBase(nodeUrl(link.node, map))}>{link.label} ↗</a>
          ))}
        </nav>
      </div>
    )}
  </div>
  <div class="atlas-graph" data-edges={JSON.stringify(section.edges)}>
    <svg class="atlas-edges" aria-hidden="true">
      <defs>
        <marker
          id={`arrow-${section.id}`}
          viewBox="0 0 10 10"
          refX="9"
          refY="5"
          markerWidth="6"
          markerHeight="6"
          orient="auto-start-reverse"
        >
          <path d="M 0 0 L 10 5 L 0 10 z" />
        </marker>
      </defs>
    </svg>
    {section.blocks.map((block) => (
      <div class="atlas-block">
        {block.label && <p class="atlas-branch-label">{block.label}</p>}
        <div class="atlas-lanes" style={`--lanes:${block.lanes.length}`}>
          {block.lanes.map((lane) => (
            <ol class="atlas-lane">
              {lane.map((id) => {
                const n = presentNode(id);
                const incoming = relations.filter((e) => e.to === id);
                return (
                  <li
                    class={`atlas-node atlas-node--${n.kind}`}
                    id={`n-${id}`}
                    data-node={id}
                    data-search={`${n.title} ${n.code} ${n.input} ${n.output} ${n.meaning}`}
                  >
                    <div class="atlas-node-top">
                      <span class="atlas-kind">
                        {
                          {
                            process: '処理',
                            data: 'データ',
                            asset: '資産・部品',
                            join: '合流・判定',
                          }[n.kind]
                        }
                      </span>
                      <a
                        class="atlas-anchor"
                        href={`#n-${id}`}
                        aria-label={`${n.title}の地点リンク`}
                      >
                        #
                      </a>
                    </div>
                    <h3>{n.title}</h3>
                    <code class="atlas-code">{n.code}</code>
                    <p class="atlas-meaning">{n.meaning}</p>
                    <dl class="atlas-io">
                      <div>
                        <dt>入</dt>
                        <dd>{n.input}</dd>
                      </div>
                      <div>
                        <dt>出</dt>
                        <dd>{n.output}</dd>
                      </div>
                    </dl>
                    {incoming.length > 0 && (
                      <p class="atlas-from">
                        <span>受け取る：</span>
                        {incoming.map((e, i) => (
                          <>
                            {i > 0 ? ' / ' : ''}
                            <a href={`#n-${e.from}`}>{e.label || presentNode(e.from).code}</a>
                          </>
                        ))}
                      </p>
                    )}
                    <details class="atlas-detail">
                      <summary aria-label={`${n.title}の補足`}>補足・つながり</summary>
                      <div class="atlas-detail-body">
                        <h4>{n.title}</h4>
                        <p>{n.detail || n.meaning}</p>
                        <p>
                          <code>{n.code}</code>
                        </p>
                        <dl>
                          <dt>入力</dt>
                          <dd>{n.input}</dd>
                          <dt>出力</dt>
                          <dd>{n.output}</dd>
                        </dl>
                        {incoming.length > 0 && (
                          <>
                            <h5>ここへ入る経路</h5>
                            <ul>
                              {incoming.map((e) => (
                                <li>
                                  <a href={`#n-${e.from}`}>{presentNode(e.from).title}</a>
                                  {e.label && `：${e.label}`}
                                </li>
                              ))}
                            </ul>
                          </>
                        )}
                        {relations.some((e) => e.from === id) && (
                          <>
                            <h5>ここから進む経路</h5>
                            <ul>
                              {relations
                                .filter((e) => e.from === id)
                                .map((e) => (
                                  <li>
                                    <a href={`#n-${e.to}`}>{presentNode(e.to).title}</a>
                                    {e.label && `：${e.label}`}
                                  </li>
                                ))}
                            </ul>
                          </>
                        )}
                        {supplements[id] && (
                          <>
                            <h5>既存教材のコード例</h5>
                            <pre><code>{supplements[id].code}</code></pre>
                            <p>{supplements[id].explanation}</p>
                            <p>{supplements[id].note}</p>
                            <ul>
                              {supplements[id].links
                                .filter((link) => !link.url.includes('/learn/maps/'))
                                .map((link) => (
                                  <li>
                                    <a href={withBase(link.url)}>{link.title}</a>
                                  </li>
                                ))}
                            </ul>
                          </>
                        )}
                        {n.lesson && (
                          <a href={withBase(`/learn/${n.lesson}/`)}>関連する教材を読む →</a>
                        )}
                        <p class="atlas-evidence">
                          Qwen内部の寸法は固定モデルの構成・実装に基づく。外部連携や改造の枝は一般的な概念図。確認条件はページ末尾に記載。
                        </p>
                      </div>
                    </details>
                  </li>
                );
              })}
            </ol>
          ))}
        </div>
      </div>
    ))}
  </div>
  {section.links && !continues && (
    <nav class="atlas-bridges" aria-label={`${section.title}の接続先`}>
      <span>つながる地点</span>
      {section.links.map((link) => (
        <a href={withBase(nodeUrl(link.node, map))}>
          {link.label} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>
  )}
</section>
